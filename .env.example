# Google Drive OAuth 2.0 installed-app credentials.
GOOGLE_DRIVE_FOLDER_ID=replace-me
GDRIVE_CLIENT_ID=replace-me.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=replace-me
GDRIVE_REFRESH_TOKEN=replace-me

# Gemini
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Meta Graph API
META_ACCESS_TOKEN=replace-me
FACEBOOK_PAGE_ID=replace-me
INSTAGRAM_ACCOUNT_ID=replace-me
META_GRAPH_API_VERSION=v23.0

# Optional
ERIN_PROFILE_PATH=erin.md
LOG_LEVEL=INFO
PUBLIC_IMAGE_TIMEOUT_SECONDS=30
INSTAGRAM_POLL_SECONDS=5
INSTAGRAM_POLL_ATTEMPTS=12
